# AgriCloud-ML Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Local MongoDB or MongoDB Atlas URI)
# Defaults to mongodb://127.0.0.1:27017/agricloud_ml
MONGO_URI=mongodb://127.0.0.1:27017/agricloud_ml

# JWT Secret for Authentication
JWT_SECRET=agricloud_super_secret_jwt_key_2026_capstone_secure_token
JWT_EXPIRES_IN=7d

# Storage Configuration ('local' or 's3')
STORAGE_MODE=local
# AWS S3 Configuration (Used if STORAGE_MODE=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=agricloud-ml-leaf-storage

# ML Service Mode ('mock' or 'real')
# In 'real' mode, backend calls the FastAPI EfficientNet-B0 endpoint
ML_MODE=mock
ML_SERVICE_URL=http://127.0.0.1:8000
